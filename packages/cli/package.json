{
  "name": "tokengator",
  "version": "0.0.0",
  "description": "Tokengator command line tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokengator/tokengator",
    "directory": "packages/cli"
  },
  "bin": {
    "tokengator": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b --noEmit",
    "dev": "bun run ./src/cli.ts",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "picocolors": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tokengator/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
