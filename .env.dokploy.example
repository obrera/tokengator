# Dokploy / docker-compose env

# Public URLs
BETTER_AUTH_URL=https://api.example.com
WEB_URL=https://app.example.com
VITE_API_URL=https://api.example.com
# Optional server-only override so SSR can talk to the internal api service directly.
INTERNAL_API_URL=http://api:3000
CORS_ORIGINS=https://app.example.com

# Database
DATABASE_URL=http://db:8080
DATABASE_AUTH_TOKEN=no-token
WAIT_FOR_DATABASE=true
# Optional: enable on the first deploy to initialize an empty database, then turn it back off.
DB_PUSH_ON_START=false

# API runtime
BETTER_AUTH_SECRET=replace-with-a-32-char-secret
BETTER_AUTH_SOLANA_SIGN_IN_ENABLED=true
HELIUS_API_KEY=replace-with-helius-key
HELIUS_CLUSTER=devnet
INDEXER_DEBUG=false
SOLANA_CLUSTER=devnet
SOLANA_ENDPOINT_PUBLIC=https://api.devnet.solana.com
SOLANA_ADMIN_ADDRESSES=
DISCORD_ADMIN_IDS=

# Discord OAuth is required for app auth.
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Discord bot is optional and stays off unless explicitly enabled.
DISCORD_BOT_START=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

